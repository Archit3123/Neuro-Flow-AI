datasource db {
  provider = "sqlserver"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String    @default("") @db.NVarChar(Max)
  status      String    @default("todo")
  priority    String    @default("medium")
  duration    Int       @default(30)
  dueDate     DateTime?
  scheduledAt DateTime?
  tags        String    @default("[]")
  source      String    @default("manual")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Meeting {
  id          String    @id @default(uuid())
  transcript  String    @db.NVarChar(Max)
  summary     String    @db.NVarChar(Max)
  keyPoints   String    @default("[]") @db.NVarChar(Max)
  actionItems String    @default("[]") @db.NVarChar(Max)
  sourceName  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}


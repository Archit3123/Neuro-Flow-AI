# Required: Azure SQL / SQL Server connection used by Prisma.
DATABASE_URL="sqlserver://<server-name>.database.windows.net:1433;database=<database-name>;user=<username>;password=<password>;encrypt=true;trustServerCertificate=false;"

# Required by the Prisma 7 MSSQL driver adapter at application runtime.
# Keep these values aligned with DATABASE_URL and do not expose them with NEXT_PUBLIC_.
DB_HOST=<server-name>.database.windows.net
DB_PORT=1433
DB_NAME=<database-name>
DB_USER=<username>
DB_PASSWORD=<password>

# Required: server-side AI provider credentials. Never use a NEXT_PUBLIC_ prefix.
AI_PROVIDER=groq
GROQ_API_KEY=<your-groq-api-key>

# Optional: defaults to llama-3.1-8b-instant.
GROQ_MODEL=llama-3.1-8b-instant
